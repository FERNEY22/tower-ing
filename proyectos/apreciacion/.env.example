# Copia este archivo a .env y pon tu cadena real. El .env esta en .gitignore.
#
# Formato Supabase/Neon (psycopg v3):
#   DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST:5432/DBNAME
#
# Ejemplos:
#   Supabase: postgresql+psycopg://postgres:CLAVE@db.xxxx.supabase.co:5432/postgres
#   Neon:     postgresql+psycopg://usuario:CLAVE@ep-xxxx.neon.tech/neondb?sslmode=require
#
DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/dbname
