# Copia este archivo a .env y completa los valores.
# OJO: todo lo que lleve prefijo VITE_ termina dentro del bundle publico.
# La proteccion real de los datos son las reglas de la Realtime Database,
# no este archivo.

# "firebase" (produccion) o "memoria" (desarrollo sin nube).
VITE_ALMACEN=memoria

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_DATABASE_URL=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
