{
  "rules": {
    ".read":  "auth != null && (auth.token.email === 'afto17@gmail.com' || auth.token.email === 'a.ferney.torres@gmail.com')",
    ".write": "auth != null && (auth.token.email === 'afto17@gmail.com' || auth.token.email === 'a.ferney.torres@gmail.com')",

    "$root": {
      "$entryId": { ".write": "newData.exists() && !data.exists()" }
    },

    "diagnostico_control": {
      "intentos": { ".read": true, "$id": { ".write": true } },
      "$seccion": { "$id": { ".write": true } }
    },

    "electronica1": {
      "participantes": { "$ccHash": { ".read": true, ".write": true } },
      "progreso":      { "$ccHash": { ".read": true, ".write": true } },
      "eventos":       { "$ccHash": { ".read": true, ".write": true } },
      "circuitos":     { "$ccHash": { ".read": true, ".write": true } }
    },

    "users": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "apps": {
      "$app": { "$seccion": { "$ccHash": { ".read": true, ".write": true } } }
    },

    "parciales": {
      "$parcial": {
        "asignacion": { "$est": { ".read": true, ".write": "!data.exists()" } },
        "conteo":     { ".read": true, "$escenario": { ".write": true, ".validate": "newData.isNumber()" } },
        "sesiones":   { "$est": { ".read": true, ".write": true } },
        "entregas":   { "$est": { ".read": true, ".write": "!data.exists()" } }
      }
    },

    "actividades": {
      "$actividad": { "$seccion": { "$id": { ".write": "!data.exists()" } } }
    }
  }
}
