# Configuracion real de produccion — proyecto tower-ing.
# Son las mismas credenciales de cliente que ya usa forms/diagnostico-control.
# OJO: todo lo que lleve prefijo VITE_ termina dentro del bundle publico.
# La proteccion real de los datos son las reglas de la Realtime Database.
#
# Se llama .env.production a proposito: Vite solo lo carga en `vite build`.
#   - `npm run build` -> modo production -> lee este archivo -> nube real.
#   - `npm run dev`   -> modo development -> NO lo lee -> almacen en memoria,
#                        que es lo que queremos para desarrollar.
#   - `npm test`      -> modo test -> NO lo lee -> las pruebas siguen contra
#                        memoria. Con esto en un `.env` normal, vitest lo carga
#                        y 50 pruebas se van a rojo intentando hablar con la nube.
#
# A diferencia de .env, este archivo NO esta en .gitignore y debe viajar en el
# commit: si falta, el siguiente `npm run build` vuelve a salir en "memoria" sin
# avisar y se deja de guardar el progreso de los estudiantes otra vez.

VITE_ALMACEN=firebase

VITE_FB_API_KEY=AIzaSyCXThSlDXwOZPSqcGSi2lMNF20bXAk1tfU
VITE_FB_AUTH_DOMAIN=tower-ing.firebaseapp.com
VITE_FB_DATABASE_URL=https://tower-ing-default-rtdb.firebaseio.com
VITE_FB_PROJECT_ID=tower-ing
VITE_FB_STORAGE_BUCKET=tower-ing.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=440636238988
VITE_FB_APP_ID=1:440636238988:web:cb8f3252c3ffd7195b1fa9
